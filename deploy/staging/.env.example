# Copy to /opt/projectum-staging/.env and replace every example value.
COMPOSE_PROJECT_NAME=projectum-staging
STAGING_PUBLIC_URL=https://staging.projectumall.com
STAGING_HTTP_PORT=18080
STAGING_DB_NAME=projectum_staging
STAGING_DB_USER=projectum_staging
APP_STAGING_SEED_ENABLED=false
BACKEND_IMAGE_TAG=local
FRONTEND_IMAGE_TAG=local
# Outgoing e-mail (IONOS). Real password only in the server .env, never in git.
MAIL_HOST=smtp.ionos.it
MAIL_PORT=587
MAIL_USERNAME=info@projectumall.com
MAIL_PASSWORD=change-me
MAIL_FROM=info@projectumall.com
APP_MAIL_DELIVERY_ENABLED=false
