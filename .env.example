# Copy to .env (git-ignored) and fill in. Read automatically by `./mvnw spring-boot:run`
# (spring.config.import=optional:file:.env[.properties]); in Docker/production pass the same
# names as container environment variables. Plain KEY=value, no quotes.

# Outgoing e-mail (IONOS Italy, STARTTLS)
MAIL_HOST=smtp.ionos.it
MAIL_PORT=587
MAIL_USERNAME=info@projectumall.com
MAIL_PASSWORD=change-me
MAIL_FROM=info@projectumall.com
